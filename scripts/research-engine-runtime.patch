+@contextmanager
+def _windows_open(reader, parts: list[str]):
+    try:
+        with reader.open(parts) as handle:
+            yield handle
+    except OSError as exc:
+        raise ActivityError("PATH", f"Windows no-reparse access failed: {exc.__class__.__name__}") from None
