+def _windows_read(root: Path, relative: str, limit: int, *, code: str) -> tuple[bytes, tuple[int, int, int]]:
+    reader = _windows_reader(root)
+    with _windows_open(reader, relative.split("/")) as handle:
+        before = reader.fingerprint(handle)
+        if (before[3] << 32 | before[4]) > limit:
+            raise ActivityError("CAP", "file exceeds hard byte cap")
+        chunks: list[bytes] = []
+        size = 0
+        while True:
+            chunk = reader.read_chunk(handle, min(1024 * 1024, limit + 1 - size))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            size += len(chunk)
+            if size > limit:
+                raise ActivityError("CAP", "file exceeds hard byte cap")
+        after = reader.fingerprint(handle)
+        if before != after or size != (after[3] << 32 | after[4]):
+            raise ActivityError(code, "file changed while being read")
+        # These ancestors and the leaf are still held against rename/write.
+        identity = _path_identity(reader.root / relative)
+        return b"".join(chunks), identity
